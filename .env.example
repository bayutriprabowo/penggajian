# Salin ke .env lalu sesuaikan
PORT=8080
DATABASE_URL=host=localhost user=payroll password=payroll dbname=payroll port=5432 sslmode=disable TimeZone=Asia/Jakarta
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRE_HOURS=24

# Iuran & batas BPJS (PP 28/2024, PP 46/2015)
BPJS_HEALTH_CAP=12000000
BPJS_HEALTH_WORKER=0.01
BPJS_HEALTH_EMPLOYER=0.04
JP_CAP=10042300
JP_WORKER=0.01
JP_EMPLOYER=0.02
JHT_WORKER=0.02
JHT_EMPLOYER=0.037
JKM_EMPLOYER=0.003

# User admin default (dibuat saat startup bila belum ada)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# Seeder data demo (karyawan, user, lembur, payroll contoh)
# Aktifkan hanya untuk pengembangan: SEED_DEMO=true
SEED_DEMO=false
DEMO_USER_PASS=rahasia123
